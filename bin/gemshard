#!/usr/bin/env ruby
# gemshard init [DIR]          make a config and a key in DIR (default: here)
# gemshard fingerprint [CONFIG] the key's fingerprint, for SHARD ADD on the hub
# gemshard [CONFIG]            run (default: config.yml)
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "gemshard"
require "fileutils"

def die(message)
  warn "gemshard: #{message}"
  exit 1
end

case ARGV[0]
when "init"
  dir = ARGV[1] || "."
  FileUtils.mkdir_p(dir)
  config = File.join(dir, "config.yml")
  unless File.exist?(config)
    File.write(config, File.read(File.expand_path("../config.example.yml", __dir__)), perm: 0o600)
    puts "Wrote #{config}: fill in name, network, hub_nick, hub_fingerprint and irc."
  end
  key = Gemshard::Identity.load(File.join(dir, "data"))
  puts "This shard's key: #{Gemshard::Protocol.fingerprint(key)}"
  puts "On the hub (as a bot admin): /msg <hub> SHARD ADD <name> #{Gemshard::Protocol.fingerprint(key)}"
when "fingerprint"
  config = Gemshard::Config.load(ARGV[1] || "config.yml")
  puts Gemshard::Protocol.fingerprint(Gemshard::Identity.load(config["data_dir"]))
else
  begin
    config = Gemshard::Config.load(ARGV[0] || "config.yml")
  rescue Gemshard::ConfigError => e
    die e.message
  end
  $stdout.sync = true
  logger = Logger.new($stdout, progname: "gemshard")
  logger.level = ENV.fetch("GEMSHARD_LOG_LEVEL", "info")
  shard = Gemshard::Shard.new(config, logger: logger)
  %w[INT TERM].each do |signal|
    trap(signal) do
      Thread.new do
        shard.stop
        exit
      end
    end
  end
  shard.run
end
